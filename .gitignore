# ── Toate scripturile Python (ramin doar pe PC local) ────────────────────────
*.py

# ── Fisiere de backup ─────────────────────────────────────────────────────────
Public/*.bak
Public/*.bak2

# ── Fisiere JSON de continut GitHub (generate automat) ────────────────────────
Public/github_contents.json
Public/github_public_contents.json

# ── Fisiere temporare Python ──────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo

# ── Fisiere de sistem Windows ─────────────────────────────────────────────────
Thumbs.db
desktop.ini
