  <style>
    .blog-bg-grid {
      position:fixed;top:0;left:0;right:0;bottom:0;pointer-events:none;z-index:0;
      background-image:linear-gradient(rgba(6,182,212,.04) 1px,transparent 1px),linear-gradient(90deg,rgba(6,182,212,.04) 1px,transparent 1px);
      background-size:60px 60px;
      mask-image:radial-gradient(ellipse 80% 70% at 50% 30%,black 0%,transparent 70%);
      -webkit-mask-image:radial-gradient(ellipse 80% 70% at 50% 30%,black 0%,transparent 70%);
    }
    .blog-bg-glow {
      position:fixed;top:-20%;left:50%;transform:translateX(-50%);
      width:800px;height:500px;
      background:radial-gradient(ellipse,rgba(6,182,212,.08) 0%,transparent 60%);
      pointer-events:none;z-index:0;
    }
    .blog-hero { text-align:center;padding:8rem 1.5rem 2rem;position:relative;z-index:1; }
    .blog-hero h1 { font-family:'Outfit',sans-serif;font-size:clamp(2.2rem,5vw,3.2rem);font-weight:900;background:linear-gradient(135deg,#fff 0%,#67e8f9 50%,#06b6d4 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;margin-bottom:.6rem; }
    .blog-hero p { color:#94a3b8;font-size:1.1rem;max-width:600px;margin:0 auto; }
    .blog-search-wrap { max-width:480px;margin:1.5rem auto 0;position:relative; }
    .blog-search { width:100%;padding:.7rem 1rem .7rem 2.8rem;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.1);border-radius:999px;color:#e2e8f0;font-size:.92rem;outline:none;transition:all .2s; }
    .blog-search:focus { border-color:rgba(6,182,212,.4);background:rgba(255,255,255,.06);box-shadow:0 0 20px rgba(6,182,212,.1); }
    .blog-search::placeholder { color:#64748b; }
    .blog-search-icon { position:absolute;left:1rem;top:50%;transform:translateY(-50%);color:#64748b;pointer-events:none; }
    .blog-filter { display:flex;justify-content:center;gap:.5rem;flex-wrap:wrap;padding:1.5rem 1.5rem 2rem;position:relative;z-index:1; }
    .blog-filter-btn { background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);color:#94a3b8;padding:.45rem 1rem;border-radius:999px;font-size:.85rem;cursor:pointer;transition:all .2s;font-family:'Inter',sans-serif; }
    .blog-filter-btn:hover,.blog-filter-btn.active { background:rgba(6,182,212,.15);border-color:rgba(6,182,212,.3);color:#67e8f9; }
    .blog-grid { display:grid;grid-template-columns:repeat(auto-fill,minmax(340px,1fr));gap:1.5rem;max-width:1100px;margin:0 auto;padding:0 1.5rem 2rem;position:relative;z-index:1; }
    .blog-card { background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.06);border-radius:1rem;padding:1.5rem;text-decoration:none;color:inherit;transition:all .25s;display:flex;flex-direction:column; }
    .blog-card:hover { background:rgba(6,182,212,.06);border-color:rgba(6,182,212,.2);transform:translateY(-2px); }
    .blog-card.hidden { display:none; }
    .blog-card-meta { display:flex;align-items:center;gap:.7rem;margin-bottom:.8rem;font-size:.82rem;color:#64748b; }
    .blog-category { background:rgba(6,182,212,.15);color:#67e8f9;padding:.18rem .6rem;border-radius:999px;font-size:.72rem;font-weight:600;text-transform:uppercase;letter-spacing:.04em; }
    .blog-card h3 { font-family:'Outfit',sans-serif;font-size:1.15rem;font-weight:700;color:#f1f5f9;margin-bottom:.5rem;line-height:1.3; }
    .blog-card h3 a { color:inherit;text-decoration:none; }
    .blog-card h3 a:hover { color:#67e8f9; }
    .blog-card p { font-size:.92rem;color:#94a3b8;line-height:1.55;flex:1;margin-bottom:.8rem; }
    .blog-read-more { font-size:.88rem;color:#67e8f9;font-weight:600;text-decoration:none;margin-top:auto;display:inline-block; }
    .blog-no-results { display:none;text-align:center;padding:3rem 1rem;color:#64748b;font-size:1rem;position:relative;z-index:1; }
    .blog-no-results.show { display:block; }
    .blog-pagination { display:flex;justify-content:center;align-items:center;gap:.5rem;padding:2rem 1.5rem 4rem;position:relative;z-index:1; }
    .blog-page-btn { width:36px;height:36px;display:flex;align-items:center;justify-content:center;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);border-radius:8px;color:#94a3b8;font-size:.85rem;font-weight:600;cursor:pointer;transition:all .2s; }
    .blog-page-btn:hover { background:rgba(6,182,212,.1);border-color:rgba(6,182,212,.3);color:#67e8f9; }
    .blog-page-btn.active { background:rgba(6,182,212,.2);border-color:rgba(6,182,212,.4);color:#67e8f9; }
    .blog-page-btn.disabled { opacity:.3;pointer-events:none; }
    .blog-page-info { color:#64748b;font-size:.82rem;margin:0 .5rem; }
    @media(max-width:600px) { .blog-grid { grid-template-columns:1fr; } .blog-hero { padding:7rem 1.5rem 1.5rem; } }
  </style>
</head>
