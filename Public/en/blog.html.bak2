      if(!matchCat) return false;
      if(!currentSearch) return true;
      var txt=(c.querySelector('h3')||{textContent:''}).textContent+' '+(c.querySelector('p')||{textContent:''}).textContent;
      return txt.toLowerCase().indexOf(currentSearch.toLowerCase())!==-1;
    });
  }
  function render(){
    var f=getFiltered(), total=f.length, pages=Math.max(1,Math.ceil(total/PER_PAGE));
    if(currentPage>pages) currentPage=pages;
    var s=(currentPage-1)*PER_PAGE;
    allCards.forEach(function(c){c.classList.add('hidden');});
    f.slice(s,s+PER_PAGE).forEach(function(c){c.classList.remove('hidden');});
    noResults.classList.toggle('show',total===0);
    renderPag(pages,total);
  }
  function renderPag(pages,total){
    pagination.innerHTML='';
    if(pages<=1) return;
    var prev=document.createElement('button'); prev.className='blog-page-btn'+(currentPage<=1?' disabled':''); prev.innerHTML='←';
    prev.onclick=function(){if(currentPage>1){currentPage--;render();scrollTo({top:0,behavior:'smooth'});}};
    pagination.appendChild(prev);
    for(var i=1;i<=pages;i++){var b=document.createElement('button');b.className='blog-page-btn'+(i===currentPage?' active':'');b.textContent=i;b.dataset.page=i;b.onclick=function(){currentPage=parseInt(this.dataset.page);render();scrollTo({top:0,behavior:'smooth'});};pagination.appendChild(b);}
    var next=document.createElement('button'); next.className='blog-page-btn'+(currentPage>=pages?' disabled':''); next.innerHTML='→';
    next.onclick=function(){if(currentPage<pages){currentPage++;render();scrollTo({top:0,behavior:'smooth'});}};
    pagination.appendChild(next);
    var info=document.createElement('span'); info.className='blog-page-info'; info.textContent=total+' articles'; pagination.appendChild(info);
  }
  document.querySelectorAll('.blog-filter-btn').forEach(function(btn){
    btn.addEventListener('click',function(){
      document.querySelectorAll('.blog-filter-btn').forEach(function(b){b.classList.remove('active');});
      btn.classList.add('active'); currentFilter=btn.dataset.filter; currentPage=1; render();
    });
  });
  var t; searchInput.addEventListener('input',function(){clearTimeout(t);t=setTimeout(function(){currentSearch=searchInput.value.trim();currentPage=1;render();},250);});
  render();
})();
</script>
</body>
